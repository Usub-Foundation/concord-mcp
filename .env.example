# Copy to .env and adjust. install.sh writes this file for you.

# Domain your partners use. DNS must point to this machine and ports 80/443 must be open,
# Caddy then gets a certificate automatically. "localhost" = local test with Caddy's own CA.
CONCORD_DOMAIN=localhost
CONCORD_PUBLIC_URL=https://localhost

# Long random string; the database is not exposed outside the compose network.
CONCORD_DB_PASSWORD=change-me

# Created on first start (existing ones are left alone). "*" marks a lead.
# Format: id[*][:area=glob,glob|area2=glob] separated by spaces.
CONCORD_NAMESPACE=main
CONCORD_NAMESPACE_NAME=My project
CONCORD_GOAL=
CONCORD_MEMBERS=alice*:backend=server/**,migrations/** bob:frontend=web/**

# Optional
# CONCORD_SECRET_KEY=   # base64 of 32 bytes; default: generated into the data volume
# CONCORD_IMAGE=ghcr.io/usub-foundation/concord-mcp:latest
# CONCORD_BIND_ADDR=0.0.0.0
# CONCORD_HTTP_PORT=80
# CONCORD_HTTPS_PORT=443
# CONCORD_LOCAL_PORT=8787
